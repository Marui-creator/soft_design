{
  "name": "svg-phase2-tools",
  "displayName": "SVG Phase 2 Tools",
  "description": "SVG file decorations for the Phase 2 assignment.",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "watch": "tsc -p . --watch"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "typescript": "^5.7.2"
  }
}
